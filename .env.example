# ============================================================
# CyberSecurity DApp — Variables de Entorno
# Copia este archivo como .env y rellena los valores
# NUNCA subas .env a git
# ============================================================

# ─── WAZUH ───────────────────────────────────────────────────
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASS=MyS3cr37P450r.*
WAZUH_DASHBOARD_URL=https://localhost:443
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=SecretPassword

# ─── RUST GATEWAY ────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
# Puerto interno del contenedor (no modificar)
GATEWAY_PORT=8080
# Puerto externo del host expuesto por Docker (evita colisión con cliente endpoint local)
GATEWAY_DOCKER_HOST_PORT=8081
GATEWAY_LOG_LEVEL=info
# Intervalo de polling a Wazuh (segundos)
WAZUH_POLL_INTERVAL=10

# ─── APIs EXTERNAS — THREAT INTELLIGENCE ─────────────────────
# AbuseIPDB: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=your_abuseipdb_key_here

# VirusTotal: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your_virustotal_key_here

# Shodan: https://account.shodan.io/
SHODAN_API_KEY=your_shodan_key_here

# GreyNoise: https://viz.greynoise.io/account/
GREYNOISE_API_KEY=your_greynoise_key_here

# AlienVault OTX: https://otx.alienvault.com/api
OTX_API_KEY=your_otx_key_here

# NVD/NIST (opcional para mayor rate limit)
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=your_nvd_key_here

# ─── BLOCKCHAIN ──────────────────────────────────────────────
# Private key de la wallet que interactúa con los contratos
# NUNCA uses tu wallet principal con fondos reales
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Sepolia Testnet RPC (Alchemy o Infura)
# Alchemy: https://dashboard.alchemy.com/
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_key

# Etherscan (para verificar contratos)
ETHERSCAN_API_KEY=your_etherscan_key_here

# Direcciones de contratos desplegados (se rellenan tras deploy)
CONTRACT_SECURITY_AUDIT=
CONTRACT_ALERT_REGISTRY=
CONTRACT_THREAT_INTEL=

# ─── FRONTEND ────────────────────────────────────────────────
# Desarrollo local (cargo run): usar puerto 8080
# Con Docker: usar puerto 8081 (mapeado por docker-compose)
VITE_GATEWAY_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws/alerts
# --- Docker mode (descomentar si usás docker-compose) ---
# VITE_GATEWAY_URL=http://localhost:8081
# VITE_WS_URL=ws://localhost:8081/ws/alerts
VITE_CHAIN_ID=31337
VITE_NETWORK_NAME=Hardhat Local

# ─── DOCKER ──────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=cybersec-dapp
# Puerto 8081 para el Gateway en Docker evita conflicto con
# el agente/cliente endpoint instalado localmente (puerto 8080)
